// Rickshaw Ride — database schema
// Roles: PASSENGER (searches nearby rickshaws, calls the driver)
//        DRIVER (rickshaw puller — goes active, shares location)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PASSENGER
  DRIVER

  @@map("user_role")
}

enum AuthProvider {
  GOOGLE
  PHONE

  @@map("auth_provider")
}

// Role is set during onboarding (after the first Google/OTP login),
// so it starts nullable.
model User {
  id           String       @id @default(uuid()) @db.Uuid
  role         UserRole?
  name         String
  phone        String?      @unique
  email        String?      @unique
  authProvider AuthProvider @map("auth_provider")
  avatarUrl    String?      @map("avatar_url")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  driverProfile DriverProfile?
  refreshTokens RefreshToken[]

  @@map("users")
}

// One per driver. The 1km "nearby" search is done with a bounding-box
// prefilter on (lat, lng) + exact haversine distance in SQL — fully
// index-backed without PostGIS. A driver is treated as offline if
// lastLocationUpdateAt goes stale (~60s).
model DriverProfile {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @unique @db.Uuid @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive             Boolean   @default(false) @map("is_active")
  rickshawNumber       String?   @map("rickshaw_number")
  lat                  Float?
  lng                  Float?
  lastLocationUpdateAt DateTime? @map("last_location_update_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([isActive, lastLocationUpdateAt])
  @@index([lat, lng])
  @@map("driver_profiles")
}

// One-time SMS codes. Only the hash is stored; codes expire in ~5 minutes
// and are marked consumed on successful verify.
model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_codes")
}

// Refresh tokens for JWT rotation. Only the hash is stored;
// revokedAt marks rotated/logged-out tokens.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
